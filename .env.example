# Copy this file to .env and fill in real values before running in production.

# Flask secret key (use a long random string in production)
SECRET_KEY=change-this-to-a-random-secret-key

# SQLite database file location (default is fine for most deployments)
DATABASE_PATH=instance/food_booking.db

# SMTP settings used to email the daily Excel booking report
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=your_email@example.com

# Default admin account created on first run (change password after first login!)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
